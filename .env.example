# ==============================================================================
# CivicLens - Backend Environment Variables Template
# Copy this file to .env or export these variables in your deployment environment.
# ==============================================================================

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/civiclens
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# JWT Authentication
# Secret key must be at least 256 bits (32+ characters)
JWT_SECRET=civiclensProductionSecretKeyMustBeAtLeast32CharactersLong2026!
JWT_EXPIRATION_MS=86400000

# Default System Administrator Provisioning (Created automatically on first boot)
ADMIN_EMAIL=admin@civiclens.gov
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator

# Media Storage Configuration
UPLOAD_DIR=uploads
