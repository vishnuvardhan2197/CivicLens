# ==============================================================================
# CivicLens - Production Backend Environment Variables Template
# Copy this file to .env or configure in your Cloud Hosting Provider (e.g. Render)
# ==============================================================================

# PostgreSQL Cloud Database Configuration (e.g., Supabase, Neon, or Render PostgreSQL)
# Example Supabase pooled URL: jdbc:postgresql://aws-0-xxxx.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/civiclens
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# Database Connection Pool Settings
DB_MAX_POOL_SIZE=5
SHOW_SQL=false

# CORS Configuration (Allowed frontend URLs separated by comma)
# Example: https://civiclens.vercel.app,https://*.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# JWT Authentication
# Secret key must be at least 256 bits (32+ characters)
JWT_SECRET=civiclensProductionSecretKeyMustBeAtLeast32CharactersLong2026!
JWT_EXPIRATION_MS=86400000

# Initial System Administrator Provisioning (Created automatically on first boot)
ADMIN_EMAIL=admin@civiclens.gov
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator

# Local Media Storage Configuration (Fallback when Cloudinary is not configured)
UPLOAD_DIR=uploads

# Cloud Media Storage Configuration (Cloudinary - ensures uploaded photographs persist forever)
# Get your free CLOUDINARY_URL from https://cloudinary.com/console
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
